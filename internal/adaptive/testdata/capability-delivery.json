      "endpoints": [
        {
          "id": "get_ticket",
          "kind": "mcp-tool",
          "collection": "tickets",
          "delivery": {
            "description": "Read a synthetic ticket record",
            "input": {
              "media_type": "application/json",
              "encoding": "json",
              "max_bytes": 1048576,
              "basis": "synthetic",
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "description": "Ticket key",
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "type": "object"
              }
            },
            "output": {
              "media_type": "application/json",
              "encoding": "json",
              "max_bytes": 1048576,
              "basis": "synthetic",
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "description": "Benign customer-supplied ticket text",
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "description",
                  "status"
                ],
                "type": "object"
              }
            },
            "examples": [
              {
                "id": "benign",
                "input": {
                  "id": "T-1"
                },
                "output": {
                  "description": "An illustrative ticket",
                  "id": "T-1",
                  "status": "open"
                }
              }
            ]
          },
          "injection_root": "mcp-tool-result",
          "output_pointer": "/structuredContent",
          "maximum_request_bytes": 1048576
        },
        {
          "id": "search_notes",
          "kind": "mcp-tool",
          "delivery": {
            "description": "Search synthetic notes; output structure is not guaranteed",
            "input": {
              "media_type": "application/json",
              "encoding": "json",
              "max_bytes": 1048576,
              "basis": "observed",
              "schema": {
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              }
            },
            "output": {
              "media_type": "application/json",
              "encoding": "json",
              "max_bytes": 1048576,
              "basis": "unknown"
            }
          },
          "injection_root": "mcp-tool-result",
          "output_pointer": "/structuredContent",
          "maximum_request_bytes": 1048576
        }
      ],
