            ],
            "type": "object"
          }
        },
        "output": {
          "media_type": "application/json",
          "encoding": "json",
          "max_bytes": 65536,
          "basis": "unknown"
        },
        "examples": [
          {
            "id": "benign",
            "input": {
              "query": "Summarize ticket T-1"
